# Social Poster MCP — Environment Variables
# Copy to .env and fill in your values
# Never commit .env to version control

# Internal API key for REST endpoints
API_KEY=your_internal_api_key_here

# CORS
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Rate limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
LOG_HEALTH_REQUESTS=false
SERVICE_NAME=Social Poster MCP
PORT=8105

# ── Reddit (OAuth2 Script App) ──
# Create at: https://www.reddit.com/prefs/apps → "script" type
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# ── X / Twitter (OAuth 1.0a) ──
# Create at: https://developer.x.com/en/portal
# Free tier: 1,500 posts/month
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ── Dev.to ──
# Get at: https://dev.to/settings/extensions → API Keys
DEVTO_API_KEY=

# ── LinkedIn (OAuth2) ──
# Create at: https://www.linkedin.com/developers/apps
# Requires r_liteprofile + w_member_social scopes
LINKEDIN_ACCESS_TOKEN=

# ── Mastodon ──
# Create at: your-instance/settings/applications
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# ── Bluesky (AT Protocol) ──
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ── Hashnode ──
# Get at: https://hashnode.com/settings/developer
HASHNODE_API_KEY=
HASHNODE_PUBLICATION_ID=

# ── Product Hunt ──
# Create at: https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_ACCESS_TOKEN=
