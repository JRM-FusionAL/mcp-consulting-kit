FROM python:3.12-slim

WORKDIR /app

# Install dependencies
# Trivy pin: pandas 2.3.3
RUN pip install --no-cache-dir "mcp[cli]==1.30.0" "fastapi==0.165.0" httpx beautifulsoup4 pandas==2.3.3

COPY intelligence_mcp.py .
COPY showcase-servers/common/ ./common/

EXPOSE 8104

CMD ["python", "intelligence_mcp.py"]
